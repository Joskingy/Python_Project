---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Portfolio from "../../layouts/Portfolio.astro";
export async function getStaticPaths() {
  return (await getCollection("projects")).map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}
interface Props {
  project: CollectionEntry<"projects">;
}
const { project } = Astro.props;
const { data } = project;
const { Content, headings } = await render(project);
const outline = headings.filter((heading) => heading.depth === 2);
---

<Portfolio title={data.title} description={data.summary}>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">/</span><a href="/projects.html"
      >Work</a
    ><span aria-hidden="true">/</span><span>{data.title}</span>
  </nav>
  <div class="case-hero">
    <p class="role">{data.status} / {data.category}</p>
    <h1 data-pagefind-meta="title">{data.title}.<br />{data.subtitle}</h1>
    <p class="lead">{data.summary}</p>
    {
      data.repository && (
        <div class="actions">
          <a class="button" href={data.repository}>
            View the repository <span aria-hidden="true">↗</span>
          </a>
        </div>
      )
    }
  </div>
  <dl class="case-meta">
    <div><dt>My contribution</dt><dd>{data.contribution}</dd></div>
    <div><dt>Built with</dt><dd>{data.stack.join(", ")}</dd></div>
    <div><dt>Scope</dt><dd>{data.scope}</dd></div>
  </dl>
  <div class="case-grid">
    <nav class="outline" aria-label="On this page" data-pagefind-ignore>
      <strong>Inside the case study</strong>
      {outline.map(({ slug, text }) => <a href={`#${slug}`}>{text}</a>)}
    </nav>
    <article class="article markdown">
      <details class="mobile-contents" data-pagefind-ignore>
        <summary>Inside the case study</summary>
        {outline.map(({ slug, text }) => <a href={`#${slug}`}>{text}</a>)}
      </details>
      <Content />
      {
        project.id === "brewmaster" && (
          <a class="related" href="/handbook/aws/github-actions-oidc.html">
            Related practice: workflow identity and AWS permissions
          </a>
        )
      }
      {
        project.id === "kubernetes-operations" && (
          <a class="related" href="/handbook/kubernetes/recovery.html">
            Related practice: investigate before recovering
          </a>
        )
      }
    </article>
  </div>
</Portfolio>
