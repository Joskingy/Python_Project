---
import { getEntry, getCollection } from "astro:content";
import Portfolio from "../layouts/Portfolio.astro";
import ProjectCard from "../components/ProjectCard.astro";
const profile = (await getEntry("profile", "oscar"))!.data;
const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Portfolio
  title="DevOps, SRE & Platform Engineering"
  description="Oscar Valdes. Enterprise operations experience, AWS architecture, practical Python automation, and dependable delivery."
  home
>
  <section class="hero" aria-labelledby="intro-title">
    <div class="hero-identity">
      <img
        class="identity-mark"
        src="/github-avatar.png"
        alt={`${profile.name}'s GitHub profile picture`}
        width="144"
        height="144"
        fetchpriority="high"
      />
      <h1 id="intro-title" data-pagefind-meta="title">{profile.name}</h1>
      <p class="role">DevOps Engineer / SRE / Platform Engineer</p>
      <p class="intro">{profile.location}</p>
      <nav
        class="hero-socials"
        aria-label="Connect with Oscar"
        data-pagefind-ignore
      >
        <a href={profile.github} aria-label="GitHub" title="GitHub">
          <svg
            viewBox="0 0 24 24"
            width="24"
            height="24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <path
              d="M9 19c-4.3 1.3-4.3-2.2-6-2.7m12 5v-3.9a3.4 3.4 0 0 0-1-2.6c3.3-.4 6.7-1.6 6.7-7.2a5.6 5.6 0 0 0-1.5-3.9A5.2 5.2 0 0 0 19 0s-1.2-.4-4 1.5a13.7 13.7 0 0 0-7 0C5.2-.4 4 0 4 0a5.2 5.2 0 0 0-.2 3.7 5.6 5.6 0 0 0-1.5 3.9c0 5.6 3.4 6.8 6.7 7.2a3.4 3.4 0 0 0-1 2.6v3.9"
              transform="translate(1 1) scale(.9)"></path>
          </svg>
        </a>
        <a href={profile.linkedin} aria-label="LinkedIn" title="LinkedIn">
          <svg
            viewBox="0 0 24 24"
            width="24"
            height="24"
            fill="currentColor"
            aria-hidden="true"
            focusable="false"
          >
            <path
              d="M20.45 2H3.55C2.69 2 2 2.68 2 3.52v16.96c0 .84.69 1.52 1.55 1.52h16.9c.86 0 1.55-.68 1.55-1.52V3.52c0-.84-.69-1.52-1.55-1.52ZM7.93 18.75H4.98V9.2h2.95v9.55ZM6.45 7.9a1.71 1.71 0 1 1 0-3.42 1.71 1.71 0 0 1 0 3.42Zm12.3 10.85H15.8v-4.64c0-1.11-.02-2.53-1.54-2.53-1.55 0-1.79 1.21-1.79 2.45v4.72H9.52V9.2h2.83v1.3h.04a3.1 3.1 0 0 1 2.79-1.53c2.98 0 3.57 1.96 3.57 4.5v5.28Z"
            ></path>
          </svg>
        </a>
        <a
          href={`mailto:${profile.email}`}
          aria-label="Email Oscar"
          title="Email Oscar"
        >
          <svg
            viewBox="0 0 24 24"
            width="24"
            height="24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <rect x="2" y="4" width="20" height="16" rx="2"></rect>
            <path d="m2 7 8.9 5.6a2 2 0 0 0 2.2 0L22 7"></path>
          </svg>
        </a>
      </nav>
    </div>
    <div class="hero-controls" data-pagefind-ignore>
      <a class="scroll-link" href="#work"
        >Explore the work <span aria-hidden="true">↓</span></a
      >
      <button
        class="motion-toggle"
        type="button"
        data-motion-toggle
        hidden
        aria-label="Pause background motion"
      >
        Pause motion
      </button>
    </div>
  </section>
  <section class="section" id="work" aria-labelledby="work-title">
    <div class="section-head">
      <h2 id="work-title">Selected work</h2>
      <a class="text-link" href="/projects.html"
        >All projects</a
      >
    </div>
    <div class="project-grid">
      {
        projects
          .filter((project) =>
            ["bototoolkit", "brewmaster"].includes(project.id),
          )
          .map((project) => <ProjectCard project={project} />)
      }
    </div>
    <a class="lab-link" href="/projects/kubernetes-operations.html"
      ><span
        >Kubernetes operations lab<small
          >EKS, Helm, troubleshooting, and rollback exercises</small
        ></span
      ><span aria-hidden="true">↗</span></a
    >
  </section>
  <section class="section notebook" aria-labelledby="notes-title">
    <div class="section-head">
      <h2 id="notes-title">From the handbook</h2>
      <a class="text-link" href="/handbook.html">Explore the handbook</a>
    </div>
    <a class="note-row" href="/handbook/aws/github-actions-oidc.html"
      ><div>
        <span class="project-kind">AWS & delivery</span>
        <h3>GitHub Actions to AWS, without stored keys</h3>
        <p>
          Workflow identity, scoped permissions, and infrastructure approval.
        </p>
      </div>
      <span aria-hidden="true">↗</span></a
    >
    <p class="notebook-caption">
      Practical notes across AWS, infrastructure as code, Kubernetes, and
      Python. Decisions, verification steps, and lessons from the projects.
    </p>
  </section>
  <section class="section about" id="about" aria-labelledby="about-title">
    <div>
      <h2 id="about-title">Grounded in operations</h2>
      <p>
        I’m a cloud engineer based in Monterrey, Mexico. My background spans
        enterprise application support, AWS architecture, and engineering
        leadership.
      </p>
      <p>
        Investigating real failures shaped how I approach automation and
        delivery. Today, my independent work focuses on practical Python tooling
        and Kubernetes operations.
      </p>
      <section class="credentials" aria-labelledby="credentials-title">
        <h3 id="credentials-title">Credentials</h3>
        <ul role="list" aria-label="AWS certifications">
          {
            profile.certifications.map((certification) => (
              <li>
                <img
                  class="certification-badge"
                  src={certification.badge}
                  alt=""
                  width="96"
                  height="96"
                  loading="lazy"
                  decoding="async"
                />
                <div>
                  <strong class="certification-name">{certification.name}</strong>
                  <small>{certification.date}</small>
                </div>
              </li>
            ))
          }
        </ul>
        <p class="credentials-education">{profile.education}</p>
      </section>
    </div>
    <div class="career" id="experience">
      {
        profile.experience.map((job) => (
          <article>
            <small>
              {job.dates} / {job.company}
            </small>
            <h3>{job.role}</h3>
            <p>{job.description}</p>
          </article>
        ))
      }
    </div>
  </section>
  <a class="lab-link" href="/projects/portfolio-engineering.html"
    ><span
      >The portfolio, engineered<small
        >Static publishing, scoped delivery, and reviewed infrastructure</small
      ></span
    ><span aria-hidden="true">↗</span></a
  >
</Portfolio>
<script>
  import "../scripts/motion";
</script>
