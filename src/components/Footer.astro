---
import { getEntry } from "astro:content";
const profile = (await getEntry("profile", "oscar"))!.data;
---

<footer class="site-footer" id="contact" data-pagefind-ignore>
  <div>
    <h2>Let’s build something dependable.</h2>
    <p>{profile.name} · {profile.location}</p>
  </div>
  <nav aria-label="Footer">
    <a href={`mailto:${profile.email}`}>Email Oscar</a>
    <a href={profile.github}>GitHub</a>
    <a href={profile.linkedin}>LinkedIn</a>
    <a href="/engineering.html">How this site ships</a>
  </nav>
</footer>
<style>
  .site-footer {
    width: min(1040px, calc(100% - 2 * var(--gutter)));
    margin-inline: auto;
    padding-block: 32px;
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    gap: 28px;
    align-items: center;
  }
  h2 {
    font: 400 19px/1.4 var(--font-heading);
    margin: 0;
    color: var(--text);
  }
  p {
    font-size: 12px;
    margin: 7px 0 0;
    color: var(--muted);
  }
  nav {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
  }
  a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--text);
    font-size: 13px;
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  @media (max-width: 900px) {
    .site-footer {
      flex-direction: column;
      align-items: start;
      gap: 14px;
    }
  }
</style>
