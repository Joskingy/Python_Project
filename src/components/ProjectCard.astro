---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import bototoolkit from "../assets/projects/bototoolkit.png";
import brewmaster from "../assets/projects/brewmaster.png";
import kubernetes from "../assets/projects/kubernetes-operations.png";
import portfolio from "../assets/projects/portfolio-engineering.png";
interface Props {
  project: CollectionEntry<"projects">;
  heading?: "h2" | "h3";
  eager?: boolean;
}
const { project, heading: Heading = "h3", eager = false } = Astro.props;
const { data, id } = project;
const url = `/projects/${id}.html`;
const covers: Record<string, ImageMetadata> = {
  bototoolkit,
  brewmaster,
  "kubernetes-operations": kubernetes,
  "portfolio-engineering": portfolio,
};
const cover = covers[id];
---

<article class="project-card">
  <div class="project-emblem" aria-hidden="true">
    <Image
      src={cover}
      alt=""
      class:list={["project-cover", { "project-cover-coffee": id === "brewmaster" }]}
      width={Math.min(800, cover.width)}
      widths={cover.width >= 800 ? [400, 800] : [400, cover.width]}
      sizes="(max-width: 600px) calc(100vw - 44px), (max-width: 1050px) calc((100vw - 84px) / 2), 352px"
      format="webp"
      quality={80}
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : undefined}
      decoding="async"
    />
  </div>
  <div class="project-card-body">
    <p class="project-kind">{data.status}</p>
    <Heading><a href={url}>{data.title}</a></Heading>
    <p>{data.summary}</p>
    <ul class="tags" aria-label={`${data.title} technologies`}>
      {data.stack.map((technology) => <li>{technology}</li>)}
    </ul>
    <a class="text-link" href={url}
      >Read the case study <span aria-hidden="true">↗</span></a
    >
  </div>
</article>
