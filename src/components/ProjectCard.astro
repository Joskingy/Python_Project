---
import type { CollectionEntry } from "astro:content";
interface Props {
  project: CollectionEntry<"projects">;
  heading?: "h2" | "h3";
}
const { project, heading: Heading = "h3" } = Astro.props;
const { data, id } = project;
const url = `/projects/${id}.html`;
---

<article class="project-card">
  <div class="project-emblem" aria-hidden="true">
    <svg viewBox="0 0 240 100" fill="none">
      {
        id === "bototoolkit" ? (
          <>
            <path
              d="M65 50h110M94 22l-28 28 28 28m52-56 28 28-28 28"
              stroke="currentColor"
              stroke-width="1.5"
            />
            <circle
              cx="120"
              cy="50"
              r="28"
              stroke="currentColor"
              stroke-opacity=".3"
            />
            <path d="M114 53l5 5 9-15" stroke="currentColor" stroke-width="2" />
          </>
        ) : id === "kubernetes-operations" ? (
          <>
            <path d="m120 10 36 20v40l-36 20-36-20V30Z" stroke="currentColor" stroke-width="1.5" />
            <path d="m120 50-36-20m36 20 36-20m-36 20v40M120 50V10" stroke="currentColor" stroke-opacity=".4" />
            <circle cx="120" cy="50" r="9" stroke="currentColor" stroke-width="1.5" />
          </>
        ) : id === "portfolio-engineering" ? (
          <>
            <rect x="47" y="22" width="146" height="62" rx="4" stroke="currentColor" stroke-width="1.5" />
            <path d="M47 37h146M77 60h86m-12-9 12 9-12 9" stroke="currentColor" stroke-width="1.5" />
            <circle cx="58" cy="29" r="2" fill="currentColor" />
            <circle cx="66" cy="29" r="2" fill="currentColor" />
          </>
        ) : (
          <path
            d="M88 42h51v20a22 22 0 0 1-22 22h-7a22 22 0 0 1-22-22zM139 47h8a12 12 0 0 1 0 24h-11M79 87h70M104 31c-10-11 9-13 0-25m18 25c-10-11 9-13 0-25"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
          />
        )
      }
    </svg>
  </div>
  <div class="project-card-body">
    <p class="project-kind">{data.status}</p>
    <Heading><a href={url}>{data.title}</a></Heading>
    <p>{data.summary}</p>
    <ul class="tags" aria-label={`${data.title} technologies`}>
      {data.stack.map((technology) => <li>{technology}</li>)}
    </ul>
    <a class="text-link" href={url}
      >Read the case study <span aria-hidden="true">↗</span></a
    >
  </div>
</article>
